<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinNewsReader.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinNewsReader.App"
    xmlns:vm="using:WinNewsReader.App.ViewModels"
    Title="WinNewsReader">

    <Grid x:Name="Root" PreviewKeyDown="OnPreviewKeyDown">
        <Grid.Resources>
            <!-- Toolbar buttons: borderless until hovered, as in NetNewsWire's unified toolbar. -->
            <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="Height" Value="34" />
            </Style>
            <Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="Height" Value="34" />
            </Style>
            <MenuFlyout x:Key="SidebarMenu" Opening="OnSidebarMenuOpening" />
            <MenuFlyout x:Key="ArticleMenu" Opening="OnArticleMenuOpening" />
            <!-- NetNewsWire's column layout: one line per article, in the columns unread, starred, feed, title and date. The
                 column header over the timeline uses the same widths. -->
            <DataTemplate x:Key="ColumnRowTemplate" x:DataType="vm:ArticleItem">
                <Grid Padding="0,6" ColumnSpacing="8" ContextFlyout="{StaticResource ArticleMenu}"
                      BorderThickness="{x:Bind vm:ArticleItem.SeparatorThickness}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                      AutomationProperties.Name="{x:Bind Title}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="76" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind IsUnread, Mode=OneWay}" />
                    <FontIcon Grid.Column="1" Glyph="&#xE735;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                              Visibility="{x:Bind IsStarred, Mode=OneWay}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind FeedName}" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Grid.Column="4" Text="{x:Bind DateText}" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.RowSpan="2">
            <Grid.Resources>
                <!-- Toolbar buttons stay borderless when disabled too; only the icon dims. -->
                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent" />
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="250" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="TimelineColumn" Width="380" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- NetNewsWire 7's toolbar sits over the three panes. Over the sidebar: Toggle Sidebar on the left, and
                 Refresh and the New menu on the right; the New menu also holds the View and Help menus' items until the
                 app has a menu bar. While the sidebar is hidden, this group moves over the timeline. -->
            <Grid x:Name="SidebarToolbar" Grid.Row="0" Grid.Column="0" Padding="8,6,8,6" ColumnSpacing="2"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnToggleSidebar"
                        ToolTipService.ToolTip="Toggle Sidebar (Ctrl+Alt+S)" AutomationProperties.Name="Toggle Sidebar">
                    <FontIcon Glyph="&#xE8A0;" FontSize="16" />
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnRefresh" IsEnabled="{x:Bind ViewModel.IsNotRefreshing, Mode=OneWay}"
                            ToolTipService.ToolTip="Refresh (Ctrl+R)" AutomationProperties.Name="Refresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="New and View Options" AutomationProperties.Name="New">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE710;" FontSize="16" />
                            <FontIcon Glyph="&#xE70D;" FontSize="8" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="OnNewMenuOpening">
                                <!-- The shortcuts themselves are registered on the window, so they work with the menu closed. -->
                                <MenuFlyoutItem Text="New Feed…" Click="OnNewFeed" KeyboardAcceleratorTextOverride="Ctrl+N" />
                                <MenuFlyoutItem Text="New Folder…" Click="OnNewFolder" KeyboardAcceleratorTextOverride="Ctrl+Shift+N" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Import Subscriptions…" Click="OnImport" />
                                <MenuFlyoutItem Text="Export Subscriptions…" Click="OnExport" KeyboardAcceleratorTextOverride="Ctrl+Alt+E" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Add FreshRSS Account…" Click="OnAddFreshRssAccount" />
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem Text="Hide Read Feeds" KeyboardAcceleratorTextOverride="Ctrl+Shift+F"
                                                      IsChecked="{x:Bind ViewModel.HideReadFeeds, Mode=OneWay}" Click="OnToggleHideReadFeeds" />
                                <RadioMenuFlyoutItem Text="Newest Article on Top" GroupName="Sort" IsChecked="{x:Bind ViewModel.SortNewestFirst, Mode=OneWay}" Click="OnSortNewestFirst" />
                                <RadioMenuFlyoutItem Text="Oldest Article on Top" GroupName="Sort" IsChecked="{x:Bind ViewModel.SortOldestFirst, Mode=OneWay}" Click="OnSortOldestFirst" />
                                <ToggleMenuFlyoutItem Text="Group by Feed" IsChecked="{x:Bind ViewModel.GroupByFeed, Mode=OneWay}" Click="OnToggleGroupByFeed" />
                                <ToggleMenuFlyoutItem Text="Use Column Layout" IsChecked="{x:Bind ViewModel.UseColumnLayout, Mode=OneWay}" Click="OnToggleColumnLayout" />
                                <MenuFlyoutSubItem Text="Sort Articles By" IsEnabled="{x:Bind ViewModel.UseColumnLayout, Mode=OneWay}">
                                    <MenuFlyoutItem Text="Date" Tag="Date" Click="OnSortByField" />
                                    <MenuFlyoutItem Text="Feed" Tag="Feed" Click="OnSortByField" />
                                    <MenuFlyoutItem Text="Title" Tag="Title" Click="OnSortByField" />
                                    <MenuFlyoutItem Text="Unread" Tag="Unread" Click="OnSortByField" />
                                    <MenuFlyoutItem Text="Starred" Tag="Starred" Click="OnSortByField" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutItem Text="Clean Up" KeyboardAcceleratorTextOverride="Ctrl+'"
                                                IsEnabled="{x:Bind ViewModel.IsHidingReadArticles, Mode=OneWay}" Click="OnCleanUp" />
                                <MenuFlyoutSeparator />
                                <!-- NetNewsWire's View > Article Theme menu, and the article text size and JavaScript from its preferences. -->
                                <MenuFlyoutSubItem x:Name="ThemeMenu" Text="Article Theme" />
                                <MenuFlyoutSubItem x:Name="TextSizeMenu" Text="Text Size" />
                                <ToggleMenuFlyoutItem Text="Enable JavaScript" IsChecked="{x:Bind ViewModel.IsArticleJavaScriptEnabled, Mode=OneWay}"
                                                      Click="OnToggleArticleJavaScript" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="UndoItem" Text="Undo" IsEnabled="False" Click="OnUndo" KeyboardAcceleratorTextOverride="Ctrl+Z" />
                                <MenuFlyoutItem x:Name="RedoItem" Text="Redo" IsEnabled="False" Click="OnRedo" KeyboardAcceleratorTextOverride="Ctrl+Y" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="New Window" Click="OnNewWindow" KeyboardAcceleratorTextOverride="Ctrl+Alt+N" />
                                <MenuFlyoutItem Text="Hide Toolbar" Click="OnToggleToolbar" KeyboardAcceleratorTextOverride="Ctrl+Alt+T" />
                                <ToggleMenuFlyoutItem x:Name="StatusBarItem" Text="Show Status Bar" IsChecked="True" Click="OnToggleStatusBar" />
                                <!-- NetNewsWire's Window menu: its small utility windows. -->
                                <MenuFlyoutSubItem Text="Window">
                                    <MenuFlyoutItem Text="Dinosaurs" Tag="Dinosaurs" Click="OnUtilityWindow" KeyboardAcceleratorTextOverride="Ctrl+6" />
                                    <MenuFlyoutItem Text="Current Activity" Tag="CurrentActivity" Click="OnUtilityWindow" KeyboardAcceleratorTextOverride="Ctrl+7" />
                                    <MenuFlyoutItem Text="Activity Log" Tag="ActivityLog" Click="OnUtilityWindow" KeyboardAcceleratorTextOverride="Ctrl+8" />
                                    <MenuFlyoutItem Text="Error Log" Tag="ErrorLog" Click="OnUtilityWindow" KeyboardAcceleratorTextOverride="Ctrl+9" />
                                    <MenuFlyoutItem Text="Account Stats" Tag="AccountStats" Click="OnUtilityWindow" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutItem Text="Find in Article…" Click="OnFindInArticle" KeyboardAcceleratorTextOverride="Ctrl+F" />
                                <MenuFlyoutItem Text="Full Screen" Click="OnFullScreen" KeyboardAcceleratorTextOverride="F11" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Preferences…" Click="OnPreferences" KeyboardAcceleratorTextOverride="Ctrl+," />
                                <!-- NetNewsWire's hidden Debug menu, shown by the ShowDebugMenu setting. -->
                                <MenuFlyoutSubItem x:Name="DebugMenu" Text="Debug" Visibility="Collapsed">
                                    <MenuFlyoutItem Text="Open Web Inspector" Click="OnOpenWebInspector" />
                                    <MenuFlyoutItem Text="Open Icon Cache Folder" Click="OnOpenIconCache" />
                                    <MenuFlyoutItem Text="Rebuild Search Index" Click="OnRebuildSearchIndex" />
                                </MenuFlyoutSubItem>
                                <!-- NetNewsWire's Help menu, pointing at this project's own pages. -->
                                <MenuFlyoutSubItem Text="Help">
                                    <MenuFlyoutItem Text="WinNewsReader Help" Click="OnHelp" KeyboardAcceleratorTextOverride="F1" />
                                    <MenuFlyoutItem Text="Keyboard Shortcuts" Click="OnKeyboardShortcutsHelp" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Website" Click="OnWebsite" />
                                    <MenuFlyoutItem Text="Release Notes" Click="OnReleaseNotes" />
                                    <MenuFlyoutItem Text="Source Code" Click="OnSourceCode" />
                                    <MenuFlyoutItem Text="Report a Problem" Click="OnReportProblem" />
                                    <MenuFlyoutItem Text="Add WinNewsReader News Feed" Click="OnAddNewsFeed" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Open App Data Folder" Click="OnOpenAppDataFolder" />
                                    <MenuFlyoutItem Text="About WinNewsReader" Click="OnAbout" />
                                </MenuFlyoutSubItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Over the timeline: Mark All as Read and Hide Read Articles. -->
            <StackPanel x:Name="TimelineToolbar" Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="2" Padding="8,6,8,6"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnMarkAllRead"
                        ToolTipService.ToolTip="Mark All as Read (Ctrl+K)" AutomationProperties.Name="Mark All as Read">
                    <FontIcon Glyph="&#xE8FB;" FontSize="16" />
                </Button>
                <ToggleButton Style="{StaticResource ToolbarToggleButtonStyle}" Click="OnToggleHideReadArticles"
                              IsChecked="{x:Bind ViewModel.IsHidingReadArticles, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanHideReadArticles, Mode=OneWay}"
                              ToolTipService.ToolTip="Hide Read Articles (Ctrl+Shift+H)" AutomationProperties.Name="Hide Read Articles">
                    <FontIcon Glyph="&#xE71C;" FontSize="16" />
                </ToggleButton>
            </StackPanel>

            <!-- Over the article: Mark Read, Star, Next Unread, Reader View, Share, Open in Browser, then Search. -->
            <Grid x:Name="ArticleToolbar" Grid.Row="0" Grid.Column="4" Padding="8,6,12,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnToggleRead" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.ReadToggleLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.ReadToggleLabel, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind ViewModel.ReadToggleGlyph, Mode=OneWay}" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnToggleStarred" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.StarToggleLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.StarToggleLabel, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind ViewModel.StarToggleGlyph, Mode=OneWay}" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnNextUnread"
                            ToolTipService.ToolTip="Next Unread (Ctrl+/)" AutomationProperties.Name="Next Unread">
                        <FontIcon Glyph="&#xE74B;" FontSize="16" />
                    </Button>
                    <ToggleButton Style="{StaticResource ToolbarToggleButtonStyle}" Click="OnToggleReaderView"
                                  IsChecked="{x:Bind ViewModel.IsShowingReaderView, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanUseReaderView, Mode=OneWay}"
                                  ToolTipService.ToolTip="{x:Bind ViewModel.ReaderViewLabel, Mode=OneWay}" AutomationProperties.Name="Reader View">
                        <FontIcon Glyph="&#xE736;" FontSize="16" />
                    </ToggleButton>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnShare" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                            ToolTipService.ToolTip="Share" AutomationProperties.Name="Share">
                        <FontIcon Glyph="&#xE72D;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnOpenInBrowser" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                            ToolTipService.ToolTip="Open in Browser" AutomationProperties.Name="Open in Browser">
                        <FontIcon Glyph="&#xE774;" FontSize="16" />
                    </Button>
                </StackPanel>
                <!-- NetNewsWire's toolbar search field: searches every article in every account. -->
                <!-- The box takes up to 220 wide, and gives way when the article pane is narrow; the spare room goes to the left. -->
                <Grid Grid.Column="1" ColumnSpacing="4" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.01*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="60" MaxWidth="220" />
                    </Grid.ColumnDefinitions>
                    <!-- NetNewsWire's search scope: this feed, folder or smart feed only, rather than every article. -->
                    <ToggleButton Grid.Column="1" Style="{StaticResource ToolbarToggleButtonStyle}" Click="OnToggleSearchScope"
                                  IsChecked="{x:Bind ViewModel.SearchCurrentTimeline, Mode=OneWay}"
                                  ToolTipService.ToolTip="Search only the current feed, folder or smart feed" AutomationProperties.Name="Search Current Feed Only">
                        <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                    </ToggleButton>
                    <TextBox x:Name="SearchBox" Grid.Column="2" HorizontalAlignment="Stretch"
                             PlaceholderText="Search (Ctrl+Alt+F)" AutomationProperties.Name="Search Articles"
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" />
                </Grid>
            </Grid>

            <TreeView x:Name="Sidebar" Grid.Row="1" Grid.Column="0" ItemsSource="{x:Bind ViewModel.SidebarItems}" DoubleTapped="OnSidebarDoubleTapped"
                      SelectionMode="Single" CanDragItems="True" CanReorderItems="False" AllowDrop="True" DragOver="OnSidebarDragOver" Drop="OnSidebarDrop"
                      DragItemsStarting="OnSidebarDragItemsStarting" DragItemsCompleted="OnSidebarDragItemsCompleted"
                      SelectionChanged="OnSidebarSelectionChanged"
                      Expanding="OnSidebarExpanding" Collapsed="OnSidebarCollapsed"
                      AutomationProperties.Name="Sidebar">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SidebarItem">
                        <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=OneWay}"
                                      ContextFlyout="{StaticResource SidebarMenu}" FontSize="{x:Bind vm:SidebarItem.TextSize}"
                                      AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                            <!-- Drops land on the row's content, ahead of the tree's own drop handling, which would
                                 rearrange rows itself. -->
                            <Grid ColumnSpacing="10" Background="Transparent"
                                  AllowDrop="True" DragOver="OnSidebarRowDragOver" Drop="OnSidebarRowDrop">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Rows chosen together with Ctrl+click or Shift+click are shaded. -->
                                <Border Grid.ColumnSpan="3" CornerRadius="4" Margin="-4,-2" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1"
                                        Visibility="{x:Bind IsMultiSelected, Mode=OneWay}" IsHitTestVisible="False" />
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Visibility="{x:Bind ShowsGlyph, Mode=OneWay}" />
                                <Image Source="{x:Bind Icon, Mode=OneWay}" Width="16" Height="16" Visibility="{x:Bind HasIcon, Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" FontWeight="{x:Bind TitleWeight}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind UnreadCountText, Mode=OneWay}" VerticalAlignment="Center"
                                           Margin="0,0,8,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </TreeViewItem>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <local:PaneSplitter x:Name="SidebarSplitter" Grid.RowSpan="2" Grid.Column="1">
                <Rectangle Width="1" HorizontalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </local:PaneSplitter>

            <!-- The column layout's header: click a column to sort by it, again to reverse it. -->
            <Grid x:Name="ColumnHeader" Grid.Row="1" Grid.Column="2" Height="30" VerticalAlignment="Top" Padding="12,0,12,0" ColumnSpacing="8"
                  Visibility="Collapsed" Background="{ThemeResource LayerFillColorDefaultBrush}" Canvas.ZIndex="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="76" />
                </Grid.ColumnDefinitions>
                <Button x:Name="HeaderUnread" Tag="Unread" Click="OnColumnHeader" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                        Width="16" Height="26" Padding="0" AutomationProperties.Name="Sort by Unread" ToolTipService.ToolTip="Sort by Unread">
                    <Ellipse Width="8" Height="8" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
                <Button x:Name="HeaderStarred" Grid.Column="1" Tag="Starred" Click="OnColumnHeader" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                        Width="16" Height="26" Padding="0" AutomationProperties.Name="Sort by Starred" ToolTipService.ToolTip="Sort by Starred">
                    <FontIcon Glyph="&#xE735;" FontSize="11" />
                </Button>
                <Button x:Name="HeaderFeed" Grid.Column="2" Tag="Feed" Click="OnColumnHeader" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                        Width="100" Height="26" Padding="0" HorizontalContentAlignment="Left" AutomationProperties.Name="Sort by Feed">
                    <TextBlock x:Name="HeaderFeedText" Text="Feed" />
                </Button>
                <Button x:Name="HeaderTitle" Grid.Column="3" Tag="Title" Click="OnColumnHeader" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Stretch" Height="26" Padding="0" HorizontalContentAlignment="Left" AutomationProperties.Name="Sort by Title">
                    <TextBlock x:Name="HeaderTitleText" Text="Title" />
                </Button>
                <Button x:Name="HeaderDate" Grid.Column="4" Tag="Date" Click="OnColumnHeader" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                        Width="76" Height="26" Padding="0" HorizontalContentAlignment="Left" AutomationProperties.Name="Sort by Date">
                    <TextBlock x:Name="HeaderDateText" Text="Date" />
                </Button>
            </Grid>

            <ListView x:Name="Timeline" Grid.Row="1" Grid.Column="2" SelectionMode="Extended" SelectionChanged="OnTimelineSelectionChanged"
                      CanDragItems="True" DragItemsStarting="OnTimelineDragItemsStarting"
                      Background="{ThemeResource LayerFillColorDefaultBrush}" AutomationProperties.Name="Timeline">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ArticleItem">
                        <Grid Padding="0,10" ColumnSpacing="8" ContextFlyout="{StaticResource ArticleMenu}"
                              BorderThickness="{x:Bind vm:ArticleItem.SeparatorThickness}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                              AutomationProperties.Name="{x:Bind Title}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="1" Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,0,0">
                                <Image Source="{x:Bind Icon, Mode=OneWay}" Visibility="{x:Bind HasIcon, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          Visibility="{x:Bind LacksIcon, Mode=OneWay}" />
                            </Grid>
                            <StackPanel Spacing="6" Margin="0,6,0,0">
                                <Ellipse Width="8" Height="8" Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                         Visibility="{x:Bind IsUnread, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE735;" FontSize="10" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                          Visibility="{x:Bind IsStarred, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind SummaryBelowTitle}" Visibility="{x:Bind HasSummaryBelowTitle}"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind FeedName}" TextTrimming="CharacterEllipsis"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind DateText}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- With no feed selected the timeline has nothing to list, so it says so, as the article pane does. -->
            <StackPanel Grid.Row="1" Grid.Column="2" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                        IsHitTestVisible="False" Visibility="{x:Bind ViewModel.HasNoFeedSelected, Mode=OneWay}">
                <FontIcon Glyph="&#xE8FD;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="No Feed Selected" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Choose a feed, folder or smart feed in the sidebar." TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <local:PaneSplitter x:Name="TimelineSplitter" Grid.RowSpan="2" Grid.Column="3">
                <Rectangle Width="1" HorizontalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </local:PaneSplitter>

            <Grid Grid.Row="1" Grid.Column="4" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <WebView2 x:Name="ArticleView" AutomationProperties.Name="Article" />
                <!-- NetNewsWire's Find in Article (Ctrl+F), as a bar over the article. -->
                <Border x:Name="FindBar" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,28,0"
                        Padding="8,6" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox x:Name="FindBox" Width="200" PlaceholderText="Find in article" AutomationProperties.Name="Find in article"
                                 TextChanged="OnFindTextChanged" KeyDown="OnFindKeyDown" />
                        <TextBlock x:Name="FindCount" VerticalAlignment="Center" MinWidth="64" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.Name="Matches" />
                        <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnFindPrevious" ToolTipService.ToolTip="Previous Match (Shift+F3)"
                                AutomationProperties.Name="Previous Match">
                            <FontIcon Glyph="&#xE70E;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnFindNext" ToolTipService.ToolTip="Next Match (F3)"
                                AutomationProperties.Name="Next Match">
                            <FontIcon Glyph="&#xE70D;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnCloseFind" ToolTipService.ToolTip="Close (Esc)"
                                AutomationProperties.Name="Close Find">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- NetNewsWire's status bar: a gear menu for the selected sidebar row, a theme menu, and a line of text that
             changes between the last refresh, the unread count, and the feed and folder counts when it's clicked. -->
        <Grid x:Name="StatusBar" Grid.Row="2" ColumnSpacing="8" Padding="8,2,12,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource ToolbarButtonStyle}" IsEnabled="{x:Bind ViewModel.HasSidebarSelection, Mode=OneWay}"
                    ToolTipService.ToolTip="Actions for the selected feed or folder" AutomationProperties.Name="Selection Actions">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
                <Button.Flyout>
                    <MenuFlyout x:Name="StatusActionsMenu" Opening="OnStatusActionsMenuOpening" />
                </Button.Flyout>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="Article Theme" AutomationProperties.Name="Article Theme">
                <FontIcon Glyph="&#xE790;" FontSize="14" />
                <Button.Flyout>
                    <MenuFlyout x:Name="StatusThemeMenu" Opening="OnStatusThemeMenuOpening" />
                </Button.Flyout>
            </Button>
            <ProgressRing Grid.Column="2" Width="14" Height="14" IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" />
            <Button Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" MinHeight="0" Padding="6,2" Background="Transparent" BorderThickness="0"
                    Click="OnStatusClicked" ToolTipService.ToolTip="Click to show the unread count, the feed count or the last refresh"
                    AutomationProperties.Name="Status">
                <TextBlock Text="{x:Bind ViewModel.StatusLine, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Button>
        </Grid>
    </Grid>
</Window>
