<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinNewsReader.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinNewsReader.App"
    xmlns:vm="using:WinNewsReader.App.ViewModels"
    Title="WinNewsReader">

    <Grid x:Name="Root" PreviewKeyDown="OnPreviewKeyDown">
        <Grid.Resources>
            <MenuFlyout x:Key="SidebarMenu" Opening="OnSidebarMenuOpening" />
            <MenuFlyout x:Key="ArticleMenu" Opening="OnArticleMenuOpening" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- NetNewsWire's toolbar order: Refresh, New | Mark All as Read | Mark Read, Star, Next Unread, Open in Browser. -->
        <Grid Grid.Row="0">
        <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Collapsed" Background="Transparent">
            <AppBarButton Label="Refresh" ToolTipService.ToolTip="Refresh (Ctrl+R)" Icon="Refresh" Click="OnRefresh"
                          IsEnabled="{x:Bind ViewModel.IsNotRefreshing, Mode=OneWay}" />
            <AppBarButton Label="New" ToolTipService.ToolTip="New Feed or Folder" Icon="Add">
                <AppBarButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <!-- The shortcuts themselves are registered on the window, so they work with the menu closed. -->
                        <MenuFlyoutItem Text="New Feed…" Click="OnNewFeed" KeyboardAcceleratorTextOverride="Ctrl+N" />
                        <MenuFlyoutItem Text="New Folder…" Click="OnNewFolder" KeyboardAcceleratorTextOverride="Ctrl+Shift+N" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Import Subscriptions…" Click="OnImport" />
                        <MenuFlyoutItem Text="Export Subscriptions…" Click="OnExport" KeyboardAcceleratorTextOverride="Ctrl+Alt+E" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Add FreshRSS Account…" Click="OnAddFreshRssAccount" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Label="Mark All as Read" ToolTipService.ToolTip="Mark All as Read (Ctrl+K)" Icon="Accept" Click="OnMarkAllRead" />
            <AppBarToggleButton Label="Hide Read Articles" ToolTipService.ToolTip="Hide Read Articles (Ctrl+Shift+H)" Icon="Filter"
                                IsChecked="{x:Bind ViewModel.IsHidingReadArticles, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanHideReadArticles, Mode=OneWay}" Click="OnToggleHideReadArticles" />
            <AppBarSeparator />
            <AppBarButton Label="{x:Bind ViewModel.ReadToggleLabel, Mode=OneWay}" Icon="Read" Click="OnToggleRead"
                          ToolTipService.ToolTip="{x:Bind ViewModel.ReadToggleLabel, Mode=OneWay}"
                          IsEnabled="{x:Bind ViewModel.HasSelectedArticle, Mode=OneWay}" />
            <AppBarButton Label="{x:Bind ViewModel.StarToggleLabel, Mode=OneWay}" Icon="Favorite" Click="OnToggleStarred"
                          ToolTipService.ToolTip="{x:Bind ViewModel.StarToggleLabel, Mode=OneWay}"
                          IsEnabled="{x:Bind ViewModel.HasSelectedArticle, Mode=OneWay}" />
            <AppBarButton Label="Next Unread" ToolTipService.ToolTip="Next Unread (Ctrl+/)" Click="OnNextUnread">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE70D;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarToggleButton Label="Reader View" ToolTipService.ToolTip="{x:Bind ViewModel.ReaderViewLabel, Mode=OneWay}"
                                IsChecked="{x:Bind ViewModel.IsShowingReaderView, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanUseReaderView, Mode=OneWay}" Click="OnToggleReaderView">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE736;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarButton Label="Open in Browser" ToolTipService.ToolTip="Open in Browser" Click="OnOpenInBrowser"
                          IsEnabled="{x:Bind ViewModel.HasSelectedArticle, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8A7;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <!-- NetNewsWire's View menu items, until the app has a menu bar. -->
            <CommandBar.SecondaryCommands>
                <AppBarToggleButton Label="Hide Read Feeds" KeyboardAcceleratorTextOverride="Ctrl+Shift+F"
                                    IsChecked="{x:Bind ViewModel.HideReadFeeds, Mode=OneWay}" Click="OnToggleHideReadFeeds" />
                <AppBarSeparator />
                <AppBarToggleButton Label="Newest Article on Top" IsChecked="{x:Bind ViewModel.SortNewestFirst, Mode=OneWay}" Click="OnSortNewestFirst" />
                <AppBarToggleButton Label="Oldest Article on Top" IsChecked="{x:Bind ViewModel.SortOldestFirst, Mode=OneWay}" Click="OnSortOldestFirst" />
                <AppBarSeparator />
                <AppBarButton Label="Clean Up" KeyboardAcceleratorTextOverride="Ctrl+'"
                              IsEnabled="{x:Bind ViewModel.IsHidingReadArticles, Mode=OneWay}" Click="OnCleanUp" />
                <AppBarSeparator />
                <!-- NetNewsWire's View > Article Theme menu, and the article text size from its preferences. -->
                <AppBarButton Label="Article Theme">
                    <AppBarButton.Flyout>
                        <MenuFlyout Opening="OnThemeMenuOpening" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Label="Text Size">
                    <AppBarButton.Flyout>
                        <MenuFlyout Opening="OnTextSizeMenuOpening" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <!-- NetNewsWire's General preference. -->
                <AppBarToggleButton Label="Enable JavaScript" IsChecked="{x:Bind ViewModel.IsArticleJavaScriptEnabled, Mode=OneWay}"
                                    Click="OnToggleArticleJavaScript" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <!-- NetNewsWire's toolbar search field, last in the toolbar: searches every article in every account. -->
        <TextBox x:Name="SearchBox" HorizontalAlignment="Right" VerticalAlignment="Center" Width="240" Margin="0,0,12,0"
                 PlaceholderText="Search Articles (Ctrl+Alt+F)" AutomationProperties.Name="Search Articles"
                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="250" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="TimelineColumn" Width="380" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="Sidebar" Grid.Column="0" ItemsSource="{x:Bind ViewModel.SidebarItems}"
                      SelectionMode="Single" CanDragItems="True" CanReorderItems="False" AllowDrop="True"
                      DragItemsStarting="OnSidebarDragItemsStarting" DragItemsCompleted="OnSidebarDragItemsCompleted"
                      SelectionChanged="OnSidebarSelectionChanged"
                      Expanding="OnSidebarExpanding" Collapsed="OnSidebarCollapsed"
                      AutomationProperties.Name="Sidebar">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SidebarItem">
                        <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=OneWay}"
                                      ContextFlyout="{StaticResource SidebarMenu}"
                                      AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                            <!-- Drops land on the row's content, ahead of the tree's own drop handling, which would
                                 rearrange rows itself. -->
                            <Grid ColumnSpacing="10" Background="Transparent"
                                  AllowDrop="True" DragOver="OnSidebarRowDragOver" Drop="OnSidebarRowDrop">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Visibility="{x:Bind ShowsGlyph, Mode=OneWay}" />
                                <Image Source="{x:Bind Icon, Mode=OneWay}" Width="16" Height="16" Visibility="{x:Bind HasIcon, Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" FontWeight="{x:Bind TitleWeight}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind UnreadCountText, Mode=OneWay}" VerticalAlignment="Center"
                                           Margin="0,0,8,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </TreeViewItem>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <local:PaneSplitter x:Name="SidebarSplitter" Grid.Column="1">
                <Rectangle Width="1" HorizontalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </local:PaneSplitter>

            <ListView x:Name="Timeline" Grid.Column="2" SelectionMode="Single" SelectionChanged="OnTimelineSelectionChanged"
                      Background="{ThemeResource LayerFillColorDefaultBrush}" AutomationProperties.Name="Timeline">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ArticleItem">
                        <Grid Padding="0,10" ColumnSpacing="8" ContextFlyout="{StaticResource ArticleMenu}"
                              AutomationProperties.Name="{x:Bind Title}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="1" Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,0,0">
                                <Image Source="{x:Bind Icon, Mode=OneWay}" Visibility="{x:Bind HasIcon, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          Visibility="{x:Bind LacksIcon, Mode=OneWay}" />
                            </Grid>
                            <StackPanel Spacing="6" Margin="0,6,0,0">
                                <Ellipse Width="8" Height="8" Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                         Visibility="{x:Bind IsUnread, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE735;" FontSize="10" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                          Visibility="{x:Bind IsStarred, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind SummaryBelowTitle}" Visibility="{x:Bind HasSummaryBelowTitle}"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind FeedName}" TextTrimming="CharacterEllipsis"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind DateText}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <local:PaneSplitter x:Name="TimelineSplitter" Grid.Column="3">
                <Rectangle Width="1" HorizontalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </local:PaneSplitter>

            <Grid Grid.Column="4" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <WebView2 x:Name="ArticleView" AutomationProperties.Name="Article" />
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Padding="12,4">
            <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
