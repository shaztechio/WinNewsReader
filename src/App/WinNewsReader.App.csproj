<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinNewsReader.App</RootNamespace>
    <AssemblyName>WinNewsReader</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Drawn by tools/make-icon.ps1. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(NETCoreSdkRuntimeIdentifier.Split('-')[1])</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Program.cs is the entry point, so Velopack's hooks and the single-instance check run before WinUI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Shown in About and used for updates. Bump it for each release. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The icon Windows shows on the app's notifications. -->
    <Content Include="Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- NetNewsWire's first-run feeds, from Shared/Importers/DefaultFeeds.opml (MIT). -->
    <Content Include="Assets\DefaultFeeds.opml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\WinNewsReader.Core.csproj" />
    <ProjectReference Include="..\Sync.GoogleReader\WinNewsReader.Sync.GoogleReader.csproj" />
  </ItemGroup>

  <!-- An unpackaged WinUI app's publish leaves out its compiled XAML and resource index, which the build puts beside the
       exe; without them the window can't load. Copy them in. -->
  <Target Name="CopyXamlToPublishDir" AfterTargets="Publish">
    <ItemGroup>
      <XamlOutput Include="$(OutDir)*.xbf" />
      <XamlOutput Include="$(OutDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(XamlOutput)" DestinationFolder="$(PublishDir)" />
  </Target>

</Project>
